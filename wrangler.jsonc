{
  // =========================================================================
  // Audits gratuits S@FE — déploiement Cloudflare Workers (assets statiques)
  // =========================================================================
  // Page publique et indexée regroupant les 4 diagnostics gratuits (RGPD,
  // SEO local, cybersécurité, réseaux sociaux), servis depuis core/audit/.
  //
  //   npm run build                       (à la racine de safe-crm)
  //   npx wrangler deploy --cwd dist/safe-audits
  //
  // ⚠️ Aucun déploiement sans validation explicite (règle projet).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safe-audits",
  "compatibility_date": "2026-10-02",
  "observability": { "enabled": true },
  // Domaine personnalisé : Cloudflare crée lui-même l'enregistrement DNS
  // `audits` et le certificat. Pas d'URL *.workers.dev publique.
  "routes": [{ "pattern": "audits.safe-digitalisation.fr", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
