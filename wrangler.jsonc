{
  // =========================================================================
  // Audits gratuits S@FE — déploiement Cloudflare Workers (assets statiques)
  // =========================================================================
  // Page publique et indexée regroupant les 4 diagnostics gratuits (RGPD,
  // SEO local, cybersécurité, réseaux sociaux), servis depuis core/audit/.
  //
  //   npm run build                       (à la racine de safe-crm)
  //   npx wrangler deploy --cwd dist/safe-audits
  //
  // ⚠️ Aucun déploiement sans validation explicite (règle projet).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "safe-audits",
  "compatibility_date": "2026-10-02",
  "observability": { "enabled": true },
  // Domaine personnalisé : Cloudflare crée lui-même l'enregistrement DNS
  // `audits` et le certificat. Pas d'URL *.workers.dev publique.
  "routes": [{ "pattern": "audits.safe-digitalisation.fr", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Worker : POST /api/send-audit (rapport au visiteur + notification à l'équipe,
  // via Brevo). Tout le reste est servi comme avant par les assets statiques.
  //   wrangler secret put BREVO      (clé API Brevo, jamais dans le dépôt)
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Anti-abus (période 10 ou 60 s uniquement). Par IP et par destinataire.
  "ratelimits": [
    { "name": "RL_IP",    "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_EMAIL", "namespace_id": "1002", "simple": { "limit": 2, "period": 60 } }
  ]
}
